# WordPress.com OAuth token exchange inputs.
# Prefer setting these in your shell for a single run, or let the script prompt.
# Do not commit real values.
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
WPCOM_USERNAME=
WPCOM_APPLICATION_PASSWORD=
WPCOM_SITE=christianthoughtsurvey.wordpress.com

# CTS operations API token.
# Store real values only in .env, .env.local, .secrets/cts.env, ~/.codex/cts.env,
# or a private shell environment. scripts/cts_ops.py auto-discovers those paths.
SURVEYOL_API_TOKEN=
SURVEYOL_API_TOKEN_EXPIRES_AT=
